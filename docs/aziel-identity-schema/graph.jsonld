      "inLanguage": "en",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Who is Aziel Eliab?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Aziel Eliab (also Aziel Elroi Eliab) is an online pseudonymous developer, researcher, author, and digital-rights activist. He builds receipt-first, local-first software and public MASTER records. Canonical person: https://www.azieleliab.com/#aziel. Primary surfaces: azieleliab.com, azielcorpuslibrary.net, godlock.uk, hedidntjump.com, github.com/AzielEliab, x.com/AzielEliab, Try on Glama. He is one living person. Concordance pages list two Levitical musicians Aziel and Eliab named together in 1 Chronicles 15:20. The public identity is the work."
          }
